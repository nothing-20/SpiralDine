# SpiralDine — DEVELOPMENT Environment Template
# Copy to `.env.development.local` (gitignored) and populate with your dedicated
# Free-Tier (Spark) Development Firebase project created per:
#   docs/governance/FREE_TIER_FIREBASE_SETUP_GUIDE.md
#
# Non-production environments MUST NOT use production project `spiral-restaurant-saas-v1`.

VITE_APP_ENV=development
VITE_USE_FIREBASE_EMULATOR=false
# Optional when VITE_USE_FIREBASE_EMULATOR=true:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088

# Dedicated Development Firebase Project Web App Config
VITE_FIREBASE_API_KEY=your_dev_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_dev_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_dev_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_dev_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_dev_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_dev_messaging_sender_id:web:your_dev_app_id

# Razorpay Payment Gateway Configuration (Sandbox / Test Mode ONLY)
VITE_RAZORPAY_KEY_ID=rzp_test_your_dev_key_id
RAZORPAY_KEY_SECRET=your_dev_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_dev_razorpay_webhook_secret_here
RAZORPAY_ENVIRONMENT=sandbox

# Server-only Firebase Config & Admin Credentials (NEVER prefix with VITE_)
FIREBASE_PROJECT_ID=your_dev_project_id
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVER_EMAIL=
# FIREBASE_SERVER_PASSWORD=

# Database maintenance script guard (explicitly matches dev project)
RESET_DEVELOPMENT_DATABASE=false

# Email Configuration (Test/Sandbox or verified support address)
SMTP_HOST=obtain_from_godaddy_email_settings
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@spiralworld.in
SMTP_PASS=your_godaddy_mailbox_or_app_password
CONTACT_FROM_EMAIL=support@spiralworld.in
CONTACT_FROM_NAME=SpiralDine Dev
CONTACT_TO_EMAIL=support@spiralworld.in
CONTACT_SEND_ACK=true

