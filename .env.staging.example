# SpiralDine — STAGING Environment Template
# Copy to `.env.staging.local` for local staging builds, or configure in
# Vercel Preview environment variables once a dedicated Free-Tier Staging Firebase
# project has been provisioned per docs/governance/FREE_TIER_FIREBASE_SETUP_GUIDE.md.
#
# Staging builds MUST NOT target production project `spiral-restaurant-saas-v1`.

VITE_APP_ENV=staging
VITE_USE_FIREBASE_EMULATOR=false

# Dedicated Staging Firebase Project Web App Config
VITE_FIREBASE_API_KEY=your_staging_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_staging_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_staging_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_staging_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_staging_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_staging_messaging_sender_id:web:your_staging_app_id

# Razorpay Payment Gateway Configuration (Test / Sandbox Mode ONLY)
VITE_RAZORPAY_KEY_ID=rzp_test_your_staging_key_id
RAZORPAY_KEY_SECRET=your_staging_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_staging_razorpay_webhook_secret_here
RAZORPAY_ENVIRONMENT=sandbox

# Server-only Firebase Config & Admin Credentials (NEVER prefix with VITE_)
FIREBASE_PROJECT_ID=your_staging_project_id
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVER_EMAIL=
# FIREBASE_SERVER_PASSWORD=

# Email Configuration (Staging / Pre-Release Verification)
SMTP_HOST=obtain_from_godaddy_email_settings
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@spiralworld.in
SMTP_PASS=your_godaddy_mailbox_or_app_password
CONTACT_FROM_EMAIL=support@spiralworld.in
CONTACT_FROM_NAME=SpiralDine Staging
CONTACT_TO_EMAIL=support@spiralworld.in
CONTACT_SEND_ACK=true

