# SpiralDine Environment Template
# Copy the appropriate environment template instead of connecting dev/staging to production:
#   - Development: copy .env.development.example -> .env.development.local
#   - Staging:     copy .env.staging.example     -> .env.staging.local
#   - Production:  see  .env.production.example  (Vercel Production env vars only)
VITE_APP_ENV=development
VITE_USE_FIREBASE_EMULATOR=false

# Firebase Client SDK Configuration Keys (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_app_id

# Server-Only Firebase Admin / Service Auth (NEVER prefix with VITE_)
FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVER_EMAIL=
# FIREBASE_SERVER_PASSWORD=

# Razorpay Payment Gateway Configuration (Test Mode)
# Client-accessible Key ID for Razorpay modal checkout
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-only keys (NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ENVIRONMENT=sandbox

# Resend Email Service & Notification Destinations (Legacy / Non-Contact Workflows)
RESEND_API_KEY=your_resend_api_key_here
ADMIN_NOTIFICATION_EMAIL=kumbhageethakrishna143@gmail.com
SUPPORT_NOTIFICATION_EMAIL=support@spiralworld.in

# Official GoDaddy Professional Email SMTP Configuration (Server-only — NEVER prefix with VITE_)
# Obtain exact SMTP_HOST, SMTP_PORT, SMTP_SECURE, and SMTP_PASS from your GoDaddy Email settings.
SMTP_HOST=obtain_from_godaddy_email_settings
SMTP_PORT=obtain_from_godaddy_email_settings
SMTP_SECURE=true_or_false_matching_port
SMTP_USER=support@spiralworld.in
SMTP_PASS=your_godaddy_mailbox_or_app_password
CONTACT_FROM_EMAIL=support@spiralworld.in
CONTACT_FROM_NAME=SpiralDine
CONTACT_TO_EMAIL=support@spiralworld.in
CONTACT_SEND_ACK=true
