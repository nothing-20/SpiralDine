# Firebase Client SDK Configuration Keys
# Copy this file to .env and fill in your values from the Firebase Console.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id

# Razorpay Payment Gateway Configuration (Test Mode)
# Client-accessible Key ID for Razorpay modal checkout
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-only keys (NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ENVIRONMENT=sandbox
