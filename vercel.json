{
  "framework": "vite",
  "buildCommand": "tsc && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/payments/razorpay/create-order",
      "destination": "/api/payments/create-order"
    },
    {
      "source": "/api/payments/razorpay/verify",
      "destination": "/api/payments/verify"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
