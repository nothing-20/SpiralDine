# SpiralDine — PRODUCTION Environment Reference Template
# Confirmed Production Firebase Project ID: spiral-restaurant-saas-v1
# Store actual values exclusively in Vercel Production Environment Variables or a
# gitignored local `.env.production.local`. NEVER commit live secrets or keys.

VITE_APP_ENV=production
VITE_USE_FIREBASE_EMULATOR=false

# Production Firebase Web SDK Config (spiral-restaurant-saas-v1)
VITE_FIREBASE_API_KEY=your_production_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=spiral-restaurant-saas-v1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spiral-restaurant-saas-v1
VITE_FIREBASE_STORAGE_BUCKET=spiral-restaurant-saas-v1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_production_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_production_messaging_sender_id:web:your_production_app_id

# Razorpay Payment Gateway Configuration (Production)
VITE_RAZORPAY_KEY_ID=your_production_razorpay_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_production_razorpay_webhook_secret
RAZORPAY_ENVIRONMENT=production

# Server-only Firebase Admin & Auth Credentials (REQUIRED in Vercel Production — NEVER prefix with VITE_)
FIREBASE_PROJECT_ID=spiral-restaurant-saas-v1
FIREBASE_SERVICE_ACCOUNT=your_service_account_json_or_base64
# Alternative individual service account variables:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Transitional server auth (until Wave 2A Admin SDK migration removes client-SDK server auth):
# FIREBASE_SERVER_EMAIL=
# FIREBASE_SERVER_PASSWORD=
SUPER_ADMIN_SETUP_SECRET=your_super_admin_setup_secret

# GoDaddy Professional Email SMTP Configuration (Server-only — NEVER prefix with VITE_)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@spiralworld.in
SMTP_PASS=your_godaddy_mailbox_or_app_password
CONTACT_FROM_EMAIL=support@spiralworld.in
CONTACT_FROM_NAME=Spiral World
CONTACT_TO_EMAIL=support@spiralworld.in
CONTACT_SEND_ACK=true

# Legacy / Secondary Notification Settings
RESEND_API_KEY=your_resend_api_key_if_still_used
ADMIN_NOTIFICATION_EMAIL=your_admin_notification_email
SUPPORT_NOTIFICATION_EMAIL=support@spiralworld.in

